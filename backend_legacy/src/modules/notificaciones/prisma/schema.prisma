// Migración: curiel_notificaciones
// Modelos: Notification, NotificationPreference, PushToken

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  inspectionId  String?   @map("inspection_id") @db.Uuid
  type          String    @db.VarChar(255)
  title         String    @db.VarChar(255)
  message       String    @db.Text
  channel       String    @default("in_app") @db.VarChar(50)
  priority      String    @default("normal") @db.VarChar(50)
  category      String    @default("system") @db.VarChar(100)
  metadata      Json?     @db.JsonB
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([inspectionId])
  @@index([category])
  @@index([priority])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  categories      Json     @default("{}") @db.JsonB
  quietHoursStart String?  @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd   String?  @map("quiet_hours_end") @db.VarChar(5)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(512)
  platform  String   @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([token])
  @@map("push_tokens")
}
