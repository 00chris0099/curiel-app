{
  "name": "CURIEL - Recordatorio 30 Minutos Antes",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "*/5 6-20 * * 1-5" }]
        }
      },
      "id": "schedule-every-5min",
      "name": "Every 5min (Mon-Fri 6am-8pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_URL}}/api/v1/inspections/internal/upcoming?minutes=35",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{$env.INTERNAL_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-upcoming",
      "name": "Get Upcoming Inspections",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "curiel-api", "name": "CURIEL API" }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data?.data || $input.first().json.data || [];\nif (!Array.isArray(data) || data.length === 0) {\n  return [];\n}\nreturn [{ json: { inspections: data, count: data.length } }];"
      },
      "id": "check-has-upcoming",
      "name": "Has Upcoming?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "const inspections = $input.first().json.inspections;\nconst now = new Date();\nconst results = [];\n\nfor (const insp of inspections) {\n  const scheduled = new Date(insp.scheduledDate);\n  const diffMs = scheduled - now;\n  const diffMin = Math.round(diffMs / 60000);\n  \n  if (diffMin <= 30 && diffMin >= 0) {\n    results.push({\n      json: {\n        inspectionId: insp.id,\n        projectName: insp.projectName,\n        inspectorId: insp.inspectorId,\n        scheduledDate: insp.scheduledDate,\n        minutesRemaining: diffMin,\n        status: insp.status\n      }\n    });\n  }\n}\n\nreturn results.length > 0 ? results : [];"
      },
      "id": "filter-30min",
      "name": "Filter <= 30min",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_URL}}/api/v1/users/{{$json.inspectorId}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{$env.INTERNAL_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-inspector",
      "name": "Get Inspector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "curiel-api", "name": "CURIEL API" }
      }
    },
    {
      "parameters": {
        "jsCode": "const insp = $input.first().json;\nconst inspector = insp.data?.data || insp.data || {};\nconst scheduled = new Date(insp.scheduledDate);\nconst frontendUrl = $env.FRONTEND_URL || 'https://curiel.vercel.app';\n\nconst html = `\n<div style='font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:0'>\n  <div style='background:#eff6ff;border-radius:16px 16px 0 0;padding:32px;text-align:center'>\n    <span style='font-size:48px'>&#9200;</span>\n    <h1 style='color:#1e40af;font-size:22px;margin:12px 0 4px;font-family:Georgia,serif'>Recordatorio de Inspeccion</h1>\n    <p style='color:#6b7280;font-size:13px;margin:0'>Faltan ${insp.minutesRemaining} minutos</p>\n  </div>\n  <div style='background:#ffffff;padding:32px;border:1px solid #e5e7eb;border-top:none;border-radius:0 0 16px 16px'>\n    <p style='color:#374151;font-size:15px;line-height:1.7;margin:0 0 16px'>Hola <strong>${inspector.fullName || 'Inspector'}</strong>,</p>\n    <p style='color:#374151;font-size:15px;line-height:1.7;margin:0 0 16px'>Tu inspeccion del proyecto <strong>${insp.projectName}</strong> esta proxima a comenzar.</p>\n    <div style='background:#f0f9ff;border-radius:10px;padding:16px;margin:20px 0'>\n      <p style='color:#1e40af;font-size:14px;margin:0;text-align:center'><strong>Hora programada:</strong> ${scheduled.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' })}</p>\n      <p style='color:#1e40af;font-size:14px;margin:8px 0 0;text-align:center'><strong>Asegurate de estar en el lugar lo antes posible.</strong></p>\n    </div>\n    <div style='text-align:center;margin:24px 0'>\n      <a href='${frontendUrl}/inspections/${insp.inspectionId}' style='display:inline-block;background:#17324a;color:#ffffff;padding:12px 28px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:600'>Ver inspeccion</a>\n    </div>\n    <hr style='border:none;border-top:1px solid #e5e7eb;margin:24px 0'>\n    <p style='color:#9ca3af;font-size:12px;text-align:center;margin:0'>CURIEL Inspecciones &middot; Recordatorio automatico</p>\n  </div>\n</div>`;\n\nreturn [{ json: { to: inspector.email, subject: `[CURIEL] Recordatorio: ${insp.projectName} en ${insp.minutesRemaining} min`, html, inspectorId: insp.inspectorId, inspectionId: insp.inspectionId } }];"
      },
      "id": "build-reminder-email",
      "name": "Build Reminder Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM_EMAIL || 'noreply@curiel.com'}}",
        "toEmail": "={{$json.to}}",
        "subject": "={{$json.subject}}",
        "html": "={{$json.html}}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "send-email",
      "name": "Send Reminder Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1500, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_URL}}/api/v1/notifications/internal/reminder",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{$env.INTERNAL_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{$('Build Reminder Email').first().json.inspectorId}}"
            },
            {
              "name": "inspectionId",
              "value": "={{$('Build Reminder Email').first().json.inspectionId}}"
            }
          ]
        },
        "options": {}
      },
      "id": "create-in-app",
      "name": "Create In-App Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "curiel-api", "name": "CURIEL API" }
      },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Every 5min (Mon-Fri 6am-8pm)": { "main": [[ { "node": "Get Upcoming Inspections", "type": "main", "index": 0 } ]] },
    "Get Upcoming Inspections": { "main": [[ { "node": "Has Upcoming?", "type": "main", "index": 0 } ]] },
    "Has Upcoming?": { "main": [[ { "node": "Filter <= 30min", "type": "main", "index": 0 } ], []] },
    "Filter <= 30min": { "main": [[ { "node": "Get Inspector", "type": "main", "index": 0 } ]] },
    "Get Inspector": { "main": [[ { "node": "Build Reminder Email", "type": "main", "index": 0 } ]] },
    "Build Reminder Email": { "main": [[ { "node": "Send Reminder Email", "type": "main", "index": 0 }, { "node": "Create In-App Notification", "type": "main", "index": 0 } ]] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
